# 数字孪生风控风洞 - 环境变量配置
# v2.1.0

# JWT认证密钥(生产环境务必修改!)
JWT_SECRET=digital-twin-risk-secret-key-change-me-in-production

# API密钥(从配置文件或这里读取)
# GEMINI_API_KEY=your_gemini_key_here
# OPENAI_API_KEY=your_openai_key_here

# 文档上传限制(MB)
MAX_DOC_UPLOAD_MB=1024

# Flask配置
FLASK_ENV=production
FLASK_DEBUG=0

# 日志级别(DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO
